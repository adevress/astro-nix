--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -11,6 +11,8 @@
 add_compile_options(-std=c++20 -Wall -DNDEBUG -Wl,--no-undefined)
 
 option (BUILD_PYTHON "Build the python bindings" YES)
+# Install prefix-relative directory of the python package (e.g. lib/python3.13/site-packages/)
+set(LOFARBEAM_PYTHON_DIR "" CACHE STRING "Prefix-relative python site-packages directory, with trailing slash")
 
 string(APPEND CMAKE_SHARED_LINKER_FLAGS " -Wl,--no-undefined")
 include(GNUInstallDirs)
@@ -126,7 +128,7 @@
 
   target_link_libraries(_stationresponse PRIVATE stationresponse ${casapylib} Python3::Module ${BOOST_PYTHON_LIBRARY})
   set_target_properties(_stationresponse PROPERTIES INSTALL_RPATH
